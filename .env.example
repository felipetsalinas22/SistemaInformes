# ═══════════════════════════════════════════════════════════════════
# Sistema de Informes de Convivencia — configuración del servidor
# Copiar este archivo a .env y completar los valores.
# NUNCA subir .env a un repositorio.
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# Conexión a PostgreSQL.
# Formato: postgres://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgres://sistema_informes:CAMBIAR_CLAVE@localhost:5432/sistema_informes

# URL(s) exactas desde las que se abre el sistema. Se usan para validar el
# origen de las peticiones (protección CSRF). Sin barra final.
# Para acceder desde otra computadora de la red local, agregue la IP del
# servidor separada por coma. Ejemplo:
# APP_ORIGIN=http://localhost:3000,http://192.168.0.190:3000
APP_ORIGIN=http://localhost:3000

# Duración de la sesión en horas (1 a 72).
SESSION_HOURS=8

# Días que tiene el alumno para presentar su descargo.
STATEMENT_DAYS=5

# Deja disponible el indicador de modo demostración en la interfaz.
# No crea datos por sí solo: los datos demo se cargan con npm run db:seed.
DEMO_MODE=true

# Cantidad de proxies inversos confiables (0 en desarrollo local, 1 detrás de Nginx/Caddy).
TRUST_PROXY=0

# Opciones SSL para PostgreSQL administrado (Supabase, Neon, etc.):
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
